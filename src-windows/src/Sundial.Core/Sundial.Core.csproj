<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic: the usage endpoint, transcript parsing, OAuth.
       It references no UI framework, so its tests can be run directly on macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI token encryption (Windows only; other platforms take the fallback path) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

</Project>
