<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sundial</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <DebugType>none</DebugType>            <!-- no .pdb needed when handing this to someone else -->
    <!-- the version is passed in by build.sh via -p:Version from VERSION at the repo root; this is only a fallback for local debugging -->
    <Version>0.0.0</Version>
    <Company>cams-nir</Company>
    <Product>Sundial</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the interface is built entirely in C#, with no .axaml markup files, bypassing the XAML compiler -->
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- neither the tray nor the window needs a Dock icon, and on Windows it stays out of the taskbar -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundial.Core\Sundial.Core.csproj" />
  </ItemGroup>

</Project>
