<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the interface offscreen to PNG so the Windows build can be checked by eye
       on a Mac. Not part of any release — a development verification tool only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sundial.App/Sundial.App.csproj" />
  </ItemGroup>
</Project>
