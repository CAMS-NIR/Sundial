<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the core layer against this machine's real Claude Code transcripts.
       The path handling is identical on macOS and Windows, so passing here means
       the logic holds there too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sundial.Core/Sundial.Core.csproj" />
  </ItemGroup>
</Project>
