# Build products
.build/
bin/
obj/
# Note: do not write *.app/ here — git is case-insensitive on macOS, so that would also
# exclude the Windows side's Sundial.App/ (the entire UI layer)
/Sundial.app/
*.exe
*.zip
src-windows/dist/Sundial.exe

# Intermediate icon products. Sundial.icns is just a copy of whichever of light/dark is
# currently enabled, which makes it a derived file — keeping it in the repo means 351KB of
# duplication, and it produces meaningless diffs whenever the icon changes.
# build.sh falls back to Sundial-light.icns when it does not exist, so a fresh clone can
# still be built straight away.
src/icon/*.iconset/
src/icon/.gen
src/Sundial.icns

# Backup directories
*-备份-*/

# macOS
.DS_Store

# Your own video working directory; it does not go into the repo
视频/
*.mp4
