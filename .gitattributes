# Text by default, with platform line endings on checkout
* text=auto

# Scripts must stay LF. Cloned on Windows and converted to CRLF, zsh/bash reports
# "bad interpreter: /bin/zsh^M" and simply will not run
*.sh   text eol=lf
*.swift text eol=lf
*.cs    text eol=lf

# Binary — never treat as text
*.icns binary
*.png  binary
*.exe  binary
*.zip  binary
